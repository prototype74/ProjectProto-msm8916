# Assign command-line arguments and define global constants
readonly API_VERSION="$1"
readonly FD_ID="$2"
readonly ZIP_FILE="$3"
readonly OUTPUT_FD="/proc/self/fd/$FD_ID"
readonly LOG_FILE="/tmp/ProjectProtoLite.log"
readonly TMP_SCRIPTS="/tmp/scripts"

set -e

if [ -e "$LOG_FILE" ]; then
    rm -f "$LOG_FILE"
fi

exec 3>>"$LOG_FILE" # Logfile file descriptor
exec 1>&3 2>&3 # Redirect stdout and stderr to logfile

ui_print() {
    local message="$1"

    echo -e "ui_print $message\nui_print" > "$OUTPUT_FD"
    echo "$message"
}

show_progress() {
    echo "progress $1 $2" > "$OUTPUT_FD"
}

set_progress() {
    echo "set_progress $1" > "$OUTPUT_FD"
}

clean_up() {
    if [ -d "$TMP_SCRIPTS" ]; then
        rm -rf "$TMP_SCRIPTS" || {
            echo "Failed to remove scripts directory" >&2
        }
    fi
}

abort() {
    local message="$1"
    local exit_code="${2:-1}"

    clean_up
    ui_print "$message"
    ui_print " "
    ui_print "Log file created at '$LOG_FILE'"
    ui_print " "
    ui_print "Failed to install ProjectProto Lite"
    ui_print " "
    sleep 0.5
    exit "$exit_code"
}

run() {
    local module="$1"
    local script

    if [ -z "$module" ]; then
        echo "run: no module specified" >&2
        return 2
    fi

    shift

    script="$TMP_SCRIPTS/${module}.sh"

    if [ ! -f "$script" ]; then
        echo "run: module '$module' not found" >&2
        return 127
    fi

    "$script" "$@"
}

# Extract script files to /tmp/scripts
mkdir -p "$TMP_SCRIPTS" || abort "Failed to create temporary scripts directory"
# awk: Length:Date:Time:Name
unzip -l "$ZIP_FILE" | awk '/^[[:space:]]*[0-9]+/ {print $4}' \
| grep '^scripts/.*\.sh$' \
| while read -r file; do
    unzip -o "$ZIP_FILE" "$file" -d "/tmp" || abort "Failed to extract script file: $file"
done
chmod -R 0755 "$TMP_SCRIPTS" || abort "Failed to set scripts permissions"

source $TMP_SCRIPTS/constants.sh
source $TMP_SCRIPTS/property_lite.sh
show_progress 1.00 0

ui_print " "
ui_print "ProjectProto Lite 1.0 - microSD repartitioner"
ui_print "for devices powered by MSM8916"
ui_print "************************************************"
ui_print "Do not remove your microSD card!"
ui_print " "

run init || abort "Failed to initialize environment" 255
run validation checkRequiredTools "$REQUIRED_TOOLS_LITE" || \
    abort "Recovery is missing required tools: $(getProperty missing_tools $PROP)" 127

# VALIDATION
ui_print "· Validation"
ui_print "-- Checking for platform compatibility"
run validation checkMSM8916Platform || abort "!! Unsupported platform. Aborting..." 7
ui_print "-- MSM8916 platform detected"
set_progress 0.05

ui_print "-- Checking microSD card"
run utilities microSdCardAvailable || abort "!! No microSD card detected" 7
set_progress 0.09

run validation checkMicroSdSizeLite || abort "!! Insufficient space on microSD card" 7
set_progress 0.13

if run utilities projectProtoLiteInstalled; then
    ui_print " "
    ui_print "ProjectProto Lite is already installed"
    ui_print " "
    clean_up
    exit 0
fi
set_progress 0.17

run utilities calculateMicroSdSize
ui_print "-- microSD card size: $(getProperty microsd_total_size $PROP)"
set_progress 0.21

ui_print "-- Validation completed!"
set_progress 0.25
ui_print " "

# REPARTITIONER
ui_print "· Repartitioner"
ui_print "-- Unmounting microSD partitions"
run utilities unmountMicroSdPartitions || abort "!! Failed to unmount microSD partitions"
set_progress 0.28

ui_print "-- Repartitioning microSD card"
run repartitioner_lite repartitionMicroSdCardLite "$OUTPUT_FD" 0.28 || abort "!! FATAL: Failed to repartition microSD card"
set_progress 0.60

ui_print "-- Formatting external partition as exFAT"
run repartitioner_lite formatExternalPartitionAsExFAT || abort "!! Failed to format external partition"
set_progress 0.70

ui_print "-- Formatting vendor partition as EXT4"
run repartitioner_lite formatVendorPartitionAsEXT4 || abort "!! Failed to format vendor partition"
set_progress 0.80

ui_print "-- Re-reading partition table from microSD card"
run utilities reReadMicroSdPartitionTable || abort "!! Failed to re-read partition table"
ui_print "-- microSD card repartitioned successfully!"
set_progress 0.85
ui_print " "

# MISC
ui_print "· Miscellaneous"
ui_print "-- Calculating target partition sizes on microSD card"
if run utilities calculateMicroSdPartitionSizes "$PARTITIONS_LITE"; then
    ui_print "   - External: $(getProperty microsd_external_size $PROP)"
    ui_print "   - Vendor: $(getProperty microsd_vendor_size $PROP)"
fi
set_progress 0.90

if ! run utilities mountMicroSdCardPartition vendor; then
    ui_print "!! Failed to mount vendor partition from microSD card"
else
    ui_print "-- Mounted vendor partition as /vendor_sdc2"
fi
set_progress 0.95
ui_print " "

if run utilities projectProtoLiteInstalled; then
    ui_print "ProjectProto Lite installed successfully!"
    ui_print " "
    ui_print "Note: Reboot to recovery to apply changes to the microSD card"
else
    ui_print "ProjectProto Lite not properly installed!"
fi
ui_print " "
set_progress 0.98

clean_up
set_progress 1.00
